#include <stdio.h>

int main()
{
    int a[] = {-2, 1, -3, 4, -1, 2, 1, -5, 4};
    int n = 9, i;
    int sum = a[0], max = a[0];

    for (i = 1; i < n; i++)
    {
        if (sum < 0)
            sum = a[i];
        else
            sum += a[i];

        if (sum > max)
            max = sum;
    }

    printf("Maximum sum = %d", max);

    return 0;
}
