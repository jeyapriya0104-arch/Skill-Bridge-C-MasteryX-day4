#include <stdio.h>

int main()
{
    int a[] = {1, 2, 3, 4, 5};
    int b[] = {3, 4, 5, 6, 7};
    int n = 5, m = 5, i, j, k;

    printf("Intersection: ");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < m; j++)
        {
            if (a[i] == b[j])
            {
                for (k = 0; k < i; k++)
                {
                    if (a[k] == a[i])
                        break;
                }

                if (k == i)
                    printf("%d ", a[i]);

                break;
            }
        }
    }

    return 0;
}
